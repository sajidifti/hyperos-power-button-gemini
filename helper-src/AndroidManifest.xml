<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.sajidifti.hyperosgeminiguard"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />
    <application android:allowBackup="false" android:hasCode="true"
        android:label="HyperOS Gemini backend guard" android:supportsRtl="true">
        <receiver android:name=".GooglePackageUpdateReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
